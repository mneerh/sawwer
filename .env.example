# ---------------------------------------------------------------------------
# Sawwer — environment variables
# Copy to .env.local and fill in. Never commit real keys.
# The app runs fully in demo mode with all of these left empty.
# ---------------------------------------------------------------------------

# Google Gemini — https://aistudio.google.com/apikey
# Server-side only. Enables multimodal analysis, Google Search grounding,
# function calling and structured journey generation.
# Without it, the app serves clearly-labelled demo content instead.
GEMINI_API_KEY=

# Google Places API (New) — used by the getPlaceDetails function call to resolve
# a landmark name to an official name, address and coordinates.
# Server-side only. Falls back to a small built-in gazetteer of Saudi heritage
# sites when absent, so map pins still work.
GOOGLE_PLACES_API_KEY=

# Google Maps — server-side. Currently read only as a fallback credential for
# Places; set it if you use one key for both APIs.
GOOGLE_MAPS_API_KEY=

# Google Maps Embed API — this one IS exposed to the browser (that is how the
# Embed API works), so restrict it by HTTP referrer in the Google Cloud console
# and enable only the Maps Embed API on it.
# When empty, the journey renders its own illustrated map instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Recommended setup: one Google Cloud project with "Generative Language API",
# "Places API (New)" and "Maps Embed API" enabled. Use a *separate*, referrer-
# restricted key for NEXT_PUBLIC_GOOGLE_MAPS_API_KEY — never reuse the server
# key there.
# ---------------------------------------------------------------------------
